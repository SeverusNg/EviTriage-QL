          "ruleId": "rule/no-snippet",
          "message": {"text": "No embedded source text"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "src/Missing.java"}, "region": {"startLine": 3, "startColumn": 2}}}]
        }
      ]
    }
  ]
}
