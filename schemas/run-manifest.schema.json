{
  "$defs": {
    "ArtifactRecord": {
      "additionalProperties": false,
      "description": "Content identity and run-relative location of one persisted artifact.",
      "properties": {
        "media_type": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "input",
            "normalized",
            "context",
            "evidence",
            "tool-log",
            "tool-output",
            "metadata",
            "model",
            "decision",
            "report"
          ],
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "sha256",
        "size_bytes",
        "role",
        "media_type"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    },
    "WorkflowEvent": {
      "additionalProperties": false,
      "description": "One append-only, ordered transition in the run audit trail.",
      "properties": {
        "error_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "event_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Event Type",
          "type": "string"
        },
        "from_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowState"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Sha256"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "output_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Sha256"
        },
        "project_spec_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Project Spec Sha256",
          "type": "string"
        },
        "retry_count": {
          "default": 0,
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "snapshot_identity": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Identity",
          "type": "string"
        },
        "to_state": {
          "$ref": "#/$defs/WorkflowState"
        },
        "tool_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Manifest Sha256"
        }
      },
      "required": [
        "sequence",
        "event_type",
        "from_state",
        "to_state",
        "project_spec_sha256",
        "snapshot_identity"
      ],
      "title": "WorkflowEvent",
      "type": "object"
    },
    "WorkflowState": {
      "description": "Implemented workflow states through the bounded Gate D decision stage.",
      "enum": [
        "CREATED",
        "PROJECT_VALIDATED",
        "WORKSPACE_READY",
        "SOURCE_READY",
        "BUILD_READY",
        "CODEQL_DB_READY",
        "SCANNED",
        "SARIF_INGESTED",
        "NORMALIZED",
        "CONTEXT_READY",
        "ANALYZED",
        "REBUTTED",
        "JUDGED",
        "INVALID_SARIF",
        "CODEQL_FAILED",
        "CONTEXT_INCOMPLETE",
        "MODEL_FAILED",
        "POLICY_REJECTED"
      ],
      "title": "WorkflowState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Current auditable summary reconstructed from the append-only event log.",
  "properties": {
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRecord"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/WorkflowEvent"
      },
      "minItems": 1,
      "title": "Events",
      "type": "array"
    },
    "input_mode": {
      "enum": [
        "sarif",
        "scan"
      ],
      "title": "Input Mode",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "project_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Project Spec Sha256",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_identity": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Identity",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/WorkflowState"
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "tool_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Tool Versions",
      "type": "object"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "project_id",
    "input_mode",
    "project_spec_sha256",
    "snapshot_identity",
    "state",
    "status",
    "events",
    "started_at",
    "updated_at"
  ],
  "title": "RunManifest",
  "type": "object"
}
