{
  "$defs": {
    "RawResultReference": {
      "additionalProperties": false,
      "description": "Stable pointer into the immutable raw SARIF artifact.",
      "properties": {
        "raw_sarif_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sarif Sha256",
          "type": "string"
        },
        "result_index": {
          "minimum": 0,
          "title": "Result Index",
          "type": "integer"
        },
        "run_index": {
          "minimum": 0,
          "title": "Run Index",
          "type": "integer"
        }
      },
      "required": [
        "raw_sarif_sha256",
        "run_index",
        "result_index"
      ],
      "title": "RawResultReference",
      "type": "object"
    },
    "SliceArtifactReference": {
      "additionalProperties": false,
      "description": "Content address and run-relative path of one persisted SliceArtifact.",
      "properties": {
        "alert_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Alert Fingerprint",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "raw_result_reference": {
          "$ref": "#/$defs/RawResultReference"
        },
        "relative_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "slice_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Slice Sha256",
          "type": "string"
        }
      },
      "required": [
        "alert_fingerprint",
        "raw_result_reference",
        "relative_path",
        "artifact_sha256",
        "slice_sha256"
      ],
      "title": "SliceArtifactReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Index binding all per-alert slices to one normalized bundle.",
  "properties": {
    "context_policy": {
      "enum": [
        "fixed_window",
        "path_function_slice"
      ],
      "title": "Context Policy",
      "type": "string"
    },
    "context_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Context Version",
      "type": "string"
    },
    "normalized_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Normalized Bundle Sha256",
      "type": "string"
    },
    "raw_sarif_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Sarif Sha256",
      "type": "string"
    },
    "repository_identity": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Repository Identity",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "slices": {
      "items": {
        "$ref": "#/$defs/SliceArtifactReference"
      },
      "title": "Slices",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "repository_identity",
    "raw_sarif_sha256",
    "normalized_bundle_sha256",
    "context_policy",
    "slices"
  ],
  "title": "ContextIndex",
  "type": "object"
}
