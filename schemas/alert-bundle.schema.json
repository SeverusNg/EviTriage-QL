{
  "$defs": {
    "DataFlowPath": {
      "additionalProperties": false,
      "description": "One threadFlow, preserved in original occurrence order.",
      "properties": {
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ],
          "title": "Completeness",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 1000000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "path_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Path Fingerprint",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/PathStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "unresolved_edges": {
          "default": [],
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Unresolved Edges",
          "type": "array"
        }
      },
      "required": [
        "ordinal",
        "steps",
        "path_fingerprint",
        "completeness"
      ],
      "title": "DataFlowPath",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "NormalizedAlert": {
      "additionalProperties": false,
      "description": "Provider-neutral normalized representation of one SARIF result.",
      "properties": {
        "additional_locations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceLocation"
          },
          "title": "Additional Locations",
          "type": "array"
        },
        "alert_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Alert Fingerprint",
          "type": "string"
        },
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "fingerprints": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Fingerprints",
          "type": "object"
        },
        "has_code_flows": {
          "title": "Has Code Flows",
          "type": "boolean"
        },
        "level": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "message": {
          "maxLength": 1000000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "partial_fingerprints": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Partial Fingerprints",
          "type": "object"
        },
        "paths": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DataFlowPath"
          },
          "title": "Paths",
          "type": "array"
        },
        "primary_location": {
          "$ref": "#/$defs/SourceLocation"
        },
        "raw_result_reference": {
          "$ref": "#/$defs/RawResultReference"
        },
        "related_locations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceLocation"
          },
          "title": "Related Locations",
          "type": "array"
        },
        "repository_identity": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Repository Identity",
          "type": "string"
        },
        "result_properties": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Result Properties",
          "type": "object"
        },
        "rule": {
          "$ref": "#/$defs/RuleMetadata"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "repository_identity",
        "rule",
        "message",
        "primary_location",
        "has_code_flows",
        "alert_fingerprint",
        "raw_result_reference"
      ],
      "title": "NormalizedAlert",
      "type": "object"
    },
    "PathStep": {
      "additionalProperties": false,
      "description": "One ordered occurrence in a SARIF thread-flow path.",
      "properties": {
        "execution_order": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Order"
        },
        "importance": {
          "anyOf": [
            {
              "enum": [
                "important",
                "essential",
                "unimportant"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Importance"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "kinds": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Kinds",
          "type": "array"
        },
        "location": {
          "$ref": "#/$defs/SourceLocation"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 1000000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "nesting_level": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nesting Level"
        },
        "provenance": {
          "const": "sarif.codeFlows",
          "default": "sarif.codeFlows",
          "title": "Provenance",
          "type": "string"
        },
        "step_kind": {
          "enum": [
            "source",
            "sink",
            "intermediate",
            "unknown"
          ],
          "title": "Step Kind",
          "type": "string"
        }
      },
      "required": [
        "index",
        "location",
        "step_kind"
      ],
      "title": "PathStep",
      "type": "object"
    },
    "RawResultReference": {
      "additionalProperties": false,
      "description": "Stable pointer into the immutable raw SARIF artifact.",
      "properties": {
        "raw_sarif_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sarif Sha256",
          "type": "string"
        },
        "result_index": {
          "minimum": 0,
          "title": "Result Index",
          "type": "integer"
        },
        "run_index": {
          "minimum": 0,
          "title": "Run Index",
          "type": "integer"
        }
      },
      "required": [
        "raw_sarif_sha256",
        "run_index",
        "result_index"
      ],
      "title": "RawResultReference",
      "type": "object"
    },
    "RuleMetadata": {
      "additionalProperties": false,
      "description": "Rule metadata resolved from the result and its tool driver.",
      "properties": {
        "cwe_ids": {
          "default": [],
          "items": {
            "pattern": "^CWE-[1-9][0-9]*$",
            "type": "string"
          },
          "title": "Cwe Ids",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "query_help_uri": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Help Uri"
        },
        "query_pack": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Pack"
        },
        "query_pack_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Pack Version"
        },
        "rule_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "security_severity": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Security Severity"
        },
        "severity": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "tags": {
          "default": [],
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "rule_id"
      ],
      "title": "RuleMetadata",
      "type": "object"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "description": "A validated source-root-relative physical location.",
      "properties": {
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "end_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Column"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "snippet": {
          "anyOf": [
            {
              "maxLength": 1000000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        },
        "start_column": {
          "default": 1,
          "minimum": 1,
          "title": "Start Column",
          "type": "integer"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "start_line"
      ],
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "All normalized results from one raw SARIF artifact.",
  "properties": {
    "alerts": {
      "items": {
        "$ref": "#/$defs/NormalizedAlert"
      },
      "title": "Alerts",
      "type": "array"
    },
    "commit_sha": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commit Sha"
    },
    "raw_sarif_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Sarif Sha256",
      "type": "string"
    },
    "repository_identity": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Repository Identity",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "repository_identity",
    "raw_sarif_sha256",
    "alerts"
  ],
  "title": "AlertBundle",
  "type": "object"
}
