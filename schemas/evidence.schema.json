{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "description": "A later-agent assertion whose evidence references must resolve.",
      "properties": {
        "claim_id": {
          "pattern": "^cl_[0-9a-f]{64}$",
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "pattern": "^ev_[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "source_controllable",
            "path_feasible",
            "sanitizer_effective",
            "sink_dangerous",
            "exploit_succeeds"
          ],
          "title": "Kind",
          "type": "string"
        },
        "produced_by": {
          "enum": [
            "analyst",
            "rebuttal",
            "judge"
          ],
          "title": "Produced By",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "statement": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "rebutted",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "kind",
        "statement",
        "status",
        "produced_by"
      ],
      "title": "Claim",
      "type": "object"
    },
    "EvidenceArtifactReference": {
      "additionalProperties": false,
      "description": "A content-addressed artifact that evidence is allowed to cite.",
      "properties": {
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "normalized",
            "slice",
            "build",
            "test",
            "verification",
            "human"
          ],
          "title": "Kind",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "relative_path",
        "artifact_sha256"
      ],
      "title": "EvidenceArtifactReference",
      "type": "object"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "description": "One provenance-bound fact or observation available to later agents.",
      "properties": {
        "alert_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Alert Fingerprint",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^ev_[0-9a-f]{64}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "excerpt": {
          "anyOf": [
            {
              "maxLength": 1000000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "extractor": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Extractor",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "enum": [
            "codeql",
            "repository",
            "build",
            "test",
            "verifier",
            "human"
          ],
          "title": "Origin",
          "type": "string"
        },
        "path_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path Fingerprint"
        },
        "polarity": {
          "enum": [
            "supports_tp",
            "supports_fp",
            "neutral"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "raw_result_reference": {
          "$ref": "#/$defs/RawResultReference"
        },
        "source_anchor": {
          "anyOf": [
            {
              "pattern": "^slice_[0-9a-f]{64}-L[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Anchor"
        },
        "strength": {
          "enum": [
            "low",
            "medium",
            "high",
            "decisive"
          ],
          "title": "Strength",
          "type": "string"
        },
        "summary": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "type": {
          "enum": [
            "source_control",
            "data_flow",
            "sink_semantics",
            "guard",
            "sanitizer",
            "config",
            "permission",
            "test",
            "verification",
            "rebuttal",
            "rule_semantics"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "alert_fingerprint",
        "raw_result_reference",
        "type",
        "polarity",
        "strength",
        "origin",
        "artifact_sha256",
        "extractor",
        "summary"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "EvidenceRelationship": {
      "additionalProperties": false,
      "description": "A typed edge between two registered evidence items.",
      "properties": {
        "relation": {
          "enum": [
            "supports",
            "rebuts",
            "depends_on",
            "unresolved"
          ],
          "title": "Relation",
          "type": "string"
        },
        "source_evidence_id": {
          "pattern": "^ev_[0-9a-f]{64}$",
          "title": "Source Evidence Id",
          "type": "string"
        },
        "target_evidence_id": {
          "pattern": "^ev_[0-9a-f]{64}$",
          "title": "Target Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "source_evidence_id",
        "relation",
        "target_evidence_id"
      ],
      "title": "EvidenceRelationship",
      "type": "object"
    },
    "RawResultReference": {
      "additionalProperties": false,
      "description": "Stable pointer into the immutable raw SARIF artifact.",
      "properties": {
        "raw_sarif_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sarif Sha256",
          "type": "string"
        },
        "result_index": {
          "minimum": 0,
          "title": "Result Index",
          "type": "integer"
        },
        "run_index": {
          "minimum": 0,
          "title": "Run Index",
          "type": "integer"
        }
      },
      "required": [
        "raw_sarif_sha256",
        "run_index",
        "result_index"
      ],
      "title": "RawResultReference",
      "type": "object"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "description": "A validated source-root-relative physical location.",
      "properties": {
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "column_kind": {
          "enum": [
            "utf16CodeUnits",
            "unicodeCodePoints"
          ],
          "title": "Column Kind",
          "type": "string"
        },
        "end_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Column"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "snippet": {
          "anyOf": [
            {
              "maxLength": 1000000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        },
        "start_column": {
          "default": 1,
          "minimum": 1,
          "title": "Start Column",
          "type": "integer"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "column_kind",
        "start_line"
      ],
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable registry that rejects unknown artifacts and dangling graph edges.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/EvidenceArtifactReference"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "claims": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Items",
      "type": "array"
    },
    "raw_sarif_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Sarif Sha256",
      "type": "string"
    },
    "relationships": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRelationship"
      },
      "title": "Relationships",
      "type": "array"
    },
    "repository_identity": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Repository Identity",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "repository_identity",
    "raw_sarif_sha256",
    "artifacts",
    "items"
  ],
  "title": "EvidenceRegistry",
  "type": "object"
}
