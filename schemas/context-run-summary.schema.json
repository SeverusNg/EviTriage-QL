{
  "$defs": {
    "ArtifactRecord": {
      "additionalProperties": false,
      "description": "Content identity and run-relative location of one persisted artifact.",
      "properties": {
        "media_type": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "input",
            "normalized",
            "context",
            "evidence",
            "tool-log",
            "tool-output",
            "metadata"
          ],
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "sha256",
        "size_bytes",
        "role",
        "media_type"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Stable CLI-facing summary of a completed Gate C input/context run.",
  "properties": {
    "alert_count": {
      "minimum": 0,
      "title": "Alert Count",
      "type": "integer"
    },
    "artifact_run_root": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Artifact Run Root",
      "type": "string"
    },
    "claim_count": {
      "default": 0,
      "minimum": 0,
      "title": "Claim Count",
      "type": "integer"
    },
    "command": {
      "enum": [
        "ingest-sarif",
        "normalize",
        "scan"
      ],
      "title": "Command",
      "type": "string"
    },
    "complete_context_count": {
      "minimum": 0,
      "title": "Complete Context Count",
      "type": "integer"
    },
    "context_index": {
      "$ref": "#/$defs/ArtifactRecord"
    },
    "evidence_count": {
      "minimum": 0,
      "title": "Evidence Count",
      "type": "integer"
    },
    "evidence_graph": {
      "$ref": "#/$defs/ArtifactRecord"
    },
    "evidence_registry": {
      "$ref": "#/$defs/ArtifactRecord"
    },
    "no_path_alert_count": {
      "minimum": 0,
      "title": "No Path Alert Count",
      "type": "integer"
    },
    "normalized_bundle": {
      "$ref": "#/$defs/ArtifactRecord"
    },
    "partial_context_count": {
      "minimum": 0,
      "title": "Partial Context Count",
      "type": "integer"
    },
    "path_count": {
      "minimum": 0,
      "title": "Path Count",
      "type": "integer"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "project_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Project Spec Sha256",
      "type": "string"
    },
    "raw_sarif": {
      "$ref": "#/$defs/ArtifactRecord"
    },
    "real_codeql": {
      "title": "Real Codeql",
      "type": "boolean"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "slice_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRecord"
      },
      "title": "Slice Artifacts",
      "type": "array"
    },
    "snapshot_identity": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Identity",
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "ingest",
        "scan"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "source_map": {
      "$ref": "#/$defs/ArtifactRecord"
    },
    "state": {
      "const": "CONTEXT_READY",
      "default": "CONTEXT_READY",
      "title": "State",
      "type": "string"
    },
    "status": {
      "const": "ok",
      "default": "ok",
      "title": "Status",
      "type": "string"
    },
    "tool_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Tool Versions",
      "type": "object"
    }
  },
  "required": [
    "command",
    "source_kind",
    "real_codeql",
    "run_id",
    "project_id",
    "project_spec_sha256",
    "snapshot_identity",
    "artifact_run_root",
    "raw_sarif",
    "normalized_bundle",
    "slice_artifacts",
    "context_index",
    "evidence_registry",
    "evidence_graph",
    "source_map",
    "alert_count",
    "path_count",
    "no_path_alert_count",
    "complete_context_count",
    "partial_context_count",
    "evidence_count"
  ],
  "title": "ContextRunSummary",
  "type": "object"
}
