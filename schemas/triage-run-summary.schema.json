{
  "$defs": {
    "ArtifactRecord": {
      "additionalProperties": false,
      "description": "Content identity and run-relative location of one persisted artifact.",
      "properties": {
        "media_type": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "input",
            "normalized",
            "context",
            "evidence",
            "tool-log",
            "tool-output",
            "metadata",
            "model",
            "decision",
            "report"
          ],
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "sha256",
        "size_bytes",
        "role",
        "media_type"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Stable CLI summary for a judged run with integrated Gate E reports.",
  "properties": {
    "alert_count": {
      "minimum": 0,
      "title": "Alert Count",
      "type": "integer"
    },
    "analysis_identity": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Analysis Identity",
      "type": "string"
    },
    "analyst_artifact": {
      "$ref": "#/$defs/ArtifactRecord"
    },
    "artifact_run_root": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Artifact Run Root",
      "type": "string"
    },
    "claim_count": {
      "minimum": 0,
      "title": "Claim Count",
      "type": "integer"
    },
    "command": {
      "const": "triage",
      "default": "triage",
      "title": "Command",
      "type": "string"
    },
    "context_index": {
      "$ref": "#/$defs/ArtifactRecord"
    },
    "evidence_count": {
      "minimum": 0,
      "title": "Evidence Count",
      "type": "integer"
    },
    "evidence_graph": {
      "$ref": "#/$defs/ArtifactRecord"
    },
    "evidence_registry": {
      "$ref": "#/$defs/ArtifactRecord"
    },
    "evidence_supplement": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fp_count": {
      "minimum": 0,
      "title": "Fp Count",
      "type": "integer"
    },
    "invocation_count": {
      "minimum": 0,
      "title": "Invocation Count",
      "type": "integer"
    },
    "judged_artifact": {
      "$ref": "#/$defs/ArtifactRecord"
    },
    "nmc_count": {
      "minimum": 0,
      "title": "Nmc Count",
      "type": "integer"
    },
    "normalized_bundle": {
      "$ref": "#/$defs/ArtifactRecord"
    },
    "path_count": {
      "minimum": 0,
      "title": "Path Count",
      "type": "integer"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "project_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Project Spec Sha256",
      "type": "string"
    },
    "raw_sarif": {
      "$ref": "#/$defs/ArtifactRecord"
    },
    "real_codeql": {
      "default": false,
      "title": "Real Codeql",
      "type": "boolean"
    },
    "rebuttal_artifact": {
      "$ref": "#/$defs/ArtifactRecord"
    },
    "report_html": {
      "$ref": "#/$defs/ArtifactRecord"
    },
    "report_jsonl": {
      "$ref": "#/$defs/ArtifactRecord"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "slice_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRecord"
      },
      "title": "Slice Artifacts",
      "type": "array"
    },
    "snapshot_identity": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Identity",
      "type": "string"
    },
    "source_kind": {
      "default": "ingest",
      "enum": [
        "ingest",
        "scan"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "source_map": {
      "$ref": "#/$defs/ArtifactRecord"
    },
    "state": {
      "const": "JUDGED",
      "default": "JUDGED",
      "title": "State",
      "type": "string"
    },
    "status": {
      "const": "ok",
      "default": "ok",
      "title": "Status",
      "type": "string"
    },
    "tool_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Tool Versions",
      "type": "object"
    },
    "tp_count": {
      "minimum": 0,
      "title": "Tp Count",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "project_id",
    "project_spec_sha256",
    "snapshot_identity",
    "analysis_identity",
    "artifact_run_root",
    "raw_sarif",
    "normalized_bundle",
    "slice_artifacts",
    "context_index",
    "evidence_registry",
    "evidence_graph",
    "source_map",
    "analyst_artifact",
    "rebuttal_artifact",
    "judged_artifact",
    "report_jsonl",
    "report_html",
    "alert_count",
    "path_count",
    "evidence_count",
    "claim_count",
    "invocation_count",
    "tp_count",
    "fp_count",
    "nmc_count"
  ],
  "title": "TriageRunSummary",
  "type": "object"
}
