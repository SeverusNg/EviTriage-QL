            "callee_behavior",
            "ownership_contract",
            "lifecycle_contract",
            "third_party_source",
            "generated_source",
            "truncated_context",
            "custom_protocol",
            "conflicting_evidence"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
