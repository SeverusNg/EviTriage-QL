{
  "$defs": {
    "AnalystOutput": {
      "additionalProperties": false,
      "description": "Structured Analyst result; it proposes claims but no final label.",
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimDraft"
          },
          "maxItems": 64,
          "title": "Claims",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unknowns": {
          "default": [],
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "claims"
      ],
      "title": "AnalystOutput",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "A later-agent assertion whose evidence references must resolve.",
      "properties": {
        "claim_id": {
          "pattern": "^cl_[0-9a-f]{64}$",
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "pattern": "^ev_[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "source_controllable",
            "path_feasible",
            "sanitizer_effective",
            "sink_dangerous",
            "exploit_succeeds",
            "resource_acquisition",
            "resource_release",
            "control_flow_exit",
            "exception_flow",
            "release_coverage",
            "feasible_unreleased_exit",
            "ownership_transfer",
            "resource_escape",
            "callee_summary",
            "lifecycle_contract",
            "context_gap"
          ],
          "title": "Kind",
          "type": "string"
        },
        "produced_by": {
          "enum": [
            "analyst",
            "rebuttal",
            "judge"
          ],
          "title": "Produced By",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "statement": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "rebutted",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "kind",
        "statement",
        "status",
        "produced_by"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimDraft": {
      "additionalProperties": false,
      "description": "Agent-authored claim content before code assigns a stable claim ID.",
      "properties": {
        "evidence_ids": {
          "default": [],
          "items": {
            "pattern": "^ev_[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "source_controllable",
            "path_feasible",
            "sanitizer_effective",
            "sink_dangerous",
            "exploit_succeeds"
          ],
          "title": "Kind",
          "type": "string"
        },
        "statement": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "rebutted",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "statement",
        "status"
      ],
      "title": "ClaimDraft",
      "type": "object"
    },
    "FinalDecision": {
      "additionalProperties": false,
      "description": "Judge candidate after the fail-closed deterministic policy is applied.",
      "properties": {
        "auto_dismiss": {
          "const": false,
          "default": false,
          "title": "Auto Dismiss",
          "type": "boolean"
        },
        "calibrated_probabilities": {
          "const": null,
          "default": null,
          "title": "Calibrated Probabilities",
          "type": "null"
        },
        "critical_claim_ids": {
          "default": [],
          "items": {
            "pattern": "^cl_[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Critical Claim Ids",
          "type": "array"
        },
        "critical_evidence_ids": {
          "default": [],
          "items": {
            "pattern": "^ev_[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Critical Evidence Ids",
          "type": "array"
        },
        "fix_guidance": {
          "default": [],
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Fix Guidance",
          "type": "array"
        },
        "label": {
          "enum": [
            "TP",
            "FP",
            "NMC"
          ],
          "title": "Label",
          "type": "string"
        },
        "next_actions": {
          "default": [],
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Next Actions",
          "type": "array"
        },
        "policy_flags": {
          "items": {
            "enum": [
              "auto_dismiss_disabled",
              "conflicting_high_strength_evidence",
              "critical_evidence_missing",
              "fp_decisive_rebuttal_present",
              "fp_missing_decisive_rebuttal",
              "high_strength_fp_blocks_tp",
              "judge_label_accepted",
              "judge_requested_nmc",
              "tp_support_missing",
              "unknown_or_unresolved",
              "resource_acquisition_missing",
              "resource_context_incomplete",
              "resource_evidence_conflict",
              "resource_fp_basis_missing",
              "resource_ownership_confirmed",
              "resource_release_coverage_confirmed",
              "resource_tp_basis_confirmed",
              "resource_unreleased_exit_missing"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Policy Flags",
          "type": "array"
        },
        "raw_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Raw Confidence",
          "type": "number"
        },
        "reasoning_summary": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Reasoning Summary",
          "type": "string"
        },
        "requested_label": {
          "enum": [
            "TP",
            "FP",
            "NMC"
          ],
          "title": "Requested Label",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TriageTarget"
        },
        "unknowns": {
          "default": [],
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "target",
        "label",
        "requested_label",
        "raw_confidence",
        "reasoning_summary",
        "policy_flags"
      ],
      "title": "FinalDecision",
      "type": "object"
    },
    "JudgeOutput": {
      "additionalProperties": false,
      "description": "Untrusted Judge candidate evaluated by deterministic code policy.",
      "properties": {
        "critical_claim_ids": {
          "default": [],
          "items": {
            "pattern": "^cl_[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Critical Claim Ids",
          "type": "array"
        },
        "critical_evidence_ids": {
          "default": [],
          "items": {
            "pattern": "^ev_[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Critical Evidence Ids",
          "type": "array"
        },
        "fix_guidance": {
          "default": [],
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Fix Guidance",
          "type": "array"
        },
        "label": {
          "enum": [
            "TP",
            "FP",
            "NMC"
          ],
          "title": "Label",
          "type": "string"
        },
        "next_actions": {
          "default": [],
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Next Actions",
          "type": "array"
        },
        "raw_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Raw Confidence",
          "type": "number"
        },
        "reasoning_summary": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Reasoning Summary",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unknowns": {
          "default": [],
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "label",
        "raw_confidence",
        "reasoning_summary"
      ],
      "title": "JudgeOutput",
      "type": "object"
    },
    "ModelInvocationRecord": {
      "additionalProperties": false,
      "description": "Non-secret provenance for one accepted or rejected structured call.",
      "properties": {
        "agent_role": {
          "enum": [
            "analyst",
            "rebuttal",
            "judge"
          ],
          "title": "Agent Role",
          "type": "string"
        },
        "attempt": {
          "maximum": 1,
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "error_code": {
          "anyOf": [
            {
              "const": "MODEL_RESPONSE_INVALID",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "model_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "profile_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "title": "Profile Id",
          "type": "string"
        },
        "prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "response_schema": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Response Schema",
          "type": "string"
        },
        "response_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Sha256"
        },
        "status": {
          "enum": [
            "accepted",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "agent_role",
        "attempt",
        "request_sha256",
        "prompt_sha256",
        "response_schema",
        "profile_id",
        "model_id",
        "status"
      ],
      "title": "ModelInvocationRecord",
      "type": "object"
    },
    "RawResultReference": {
      "additionalProperties": false,
      "description": "Stable pointer into the immutable raw SARIF artifact.",
      "properties": {
        "raw_sarif_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sarif Sha256",
          "type": "string"
        },
        "result_index": {
          "minimum": 0,
          "title": "Result Index",
          "type": "integer"
        },
        "run_index": {
          "minimum": 0,
          "title": "Run Index",
          "type": "integer"
        }
      },
      "required": [
        "raw_sarif_sha256",
        "run_index",
        "result_index"
      ],
      "title": "RawResultReference",
      "type": "object"
    },
    "RebuttalOutput": {
      "additionalProperties": false,
      "description": "Structured Rebuttal result tied to existing Analyst claim IDs.",
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimDraft"
          },
          "maxItems": 64,
          "title": "Claims",
          "type": "array"
        },
        "rebutted_claim_ids": {
          "default": [],
          "items": {
            "pattern": "^cl_[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Rebutted Claim Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unknowns": {
          "default": [],
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "claims"
      ],
      "title": "RebuttalOutput",
      "type": "object"
    },
    "ResourceAnalystOutput": {
      "additionalProperties": false,
      "description": "Resource Analyst result with explicit acquisition and path obligations.",
      "properties": {
        "acquisition_condition": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Acquisition Condition",
          "type": "string"
        },
        "acquisition_evidence_ids": {
          "items": {
            "pattern": "^ev_[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Acquisition Evidence Ids",
          "type": "array"
        },
        "acquisition_succeeds": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Acquisition Succeeds",
          "type": "string"
        },
        "callee_release_behavior": {
          "$ref": "#/$defs/ResourceAssessment"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ResourceClaimDraft"
          },
          "maxItems": 64,
          "title": "Claims",
          "type": "array"
        },
        "context_gaps": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResourceContextGap"
          },
          "maxItems": 64,
          "title": "Context Gaps",
          "type": "array"
        },
        "feasible_unreleased_exit": {
          "$ref": "#/$defs/ResourceExitAssessment"
        },
        "lifecycle_contract": {
          "$ref": "#/$defs/ResourceAssessment"
        },
        "ownership_transfer": {
          "$ref": "#/$defs/ResourceAssessment"
        },
        "release_coverage": {
          "$ref": "#/$defs/ResourceAssessment"
        },
        "release_sites": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResourceReleaseSite"
          },
          "maxItems": 64,
          "title": "Release Sites",
          "type": "array"
        },
        "resource_escape": {
          "$ref": "#/$defs/ResourceAssessment"
        },
        "resource_kind": {
          "enum": [
            "input",
            "output",
            "database",
            "lock"
          ],
          "title": "Resource Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unknowns": {
          "default": [],
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "resource_kind",
        "acquisition_succeeds",
        "acquisition_condition",
        "acquisition_evidence_ids",
        "release_coverage",
        "feasible_unreleased_exit",
        "ownership_transfer",
        "resource_escape",
        "callee_release_behavior",
        "lifecycle_contract",
        "claims"
      ],
      "title": "ResourceAnalystOutput",
      "type": "object"
    },
    "ResourceAssessment": {
      "additionalProperties": false,
      "description": "Evidence-bound answer for one lifecycle question.",
      "properties": {
        "detail": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^ev_[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "confirmed",
            "absent",
            "unknown",
            "conflicting"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "detail",
        "evidence_ids"
      ],
      "title": "ResourceAssessment",
      "type": "object"
    },
    "ResourceClaimDraft": {
      "additionalProperties": false,
      "description": "Resource-specific claim content before code assigns a stable claim ID.",
      "properties": {
        "evidence_ids": {
          "items": {
            "pattern": "^ev_[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "resource_acquisition",
            "resource_release",
            "control_flow_exit",
            "exception_flow",
            "release_coverage",
            "feasible_unreleased_exit",
            "ownership_transfer",
            "resource_escape",
            "callee_summary",
            "lifecycle_contract",
            "context_gap"
          ],
          "title": "Kind",
          "type": "string"
        },
        "statement": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "rebutted",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "statement",
        "status",
        "evidence_ids"
      ],
      "title": "ResourceClaimDraft",
      "type": "object"
    },
    "ResourceContextGap": {
      "additionalProperties": false,
      "description": "One explicit missing fact that prevents safe lifecycle reasoning.",
      "properties": {
        "detail": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^ev_[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "resource_identity",
            "acquisition_success",
