{
  "$defs": {
    "ContextCandidate": {
      "additionalProperties": false,
      "description": "A lexical guard or sanitizer candidate, never a semantic fact.",
      "properties": {
        "excerpt": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "extractor": {
          "const": "java-lexical-candidate@1",
          "default": "java-lexical-candidate@1",
          "title": "Extractor",
          "type": "string"
        },
        "kind": {
          "enum": [
            "guard",
            "sanitizer"
          ],
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/SourceLocation"
        }
      },
      "required": [
        "kind",
        "location",
        "excerpt"
      ],
      "title": "ContextCandidate",
      "type": "object"
    },
    "ContextOmission": {
      "additionalProperties": false,
      "description": "One explicit reason requested context could not be included.",
      "properties": {
        "code": {
          "enum": [
            "source_file_missing",
            "resource_context_bound",
            "source_not_regular",
            "source_too_large",
            "binary_source",
            "unsupported_encoding",
            "coordinate_out_of_bounds",
            "source_digest_mismatch",
            "function_boundary_unresolved",
            "token_budget_exceeded"
          ],
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "code",
        "path",
        "detail"
      ],
      "title": "ContextOmission",
      "type": "object"
    },
    "ContextReference": {
      "additionalProperties": false,
      "description": "Why one normalized source location selected a source slice.",
      "properties": {
        "kind": {
          "enum": [
            "primary",
            "additional",
            "related",
            "source",
            "sink",
            "path_step",
            "callee"
          ],
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/SourceLocation"
        },
        "path_ordinal": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path Ordinal"
        },
        "step_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Index"
        }
      },
      "required": [
        "kind",
        "location"
      ],
      "title": "ContextReference",
      "type": "object"
    },
    "DataFlowPath": {
      "additionalProperties": false,
      "description": "One threadFlow, preserved in original occurrence order.",
      "properties": {
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ],
          "title": "Completeness",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 1000000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "path_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Path Fingerprint",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/PathStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "unresolved_edges": {
          "default": [],
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Unresolved Edges",
          "type": "array"
        }
      },
      "required": [
        "ordinal",
        "steps",
        "path_fingerprint",
        "completeness"
      ],
      "title": "DataFlowPath",
      "type": "object"
    },
    "LevelZeroContext": {
      "additionalProperties": false,
      "description": "Normalized alert facts included without reparsing SARIF.",
      "properties": {
        "additional_locations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceLocation"
          },
          "title": "Additional Locations",
          "type": "array"
        },
        "message": {
          "maxLength": 1000000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/DataFlowPath"
          },
          "title": "Paths",
          "type": "array"
        },
        "primary_location": {
          "$ref": "#/$defs/SourceLocation"
        },
        "related_locations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceLocation"
          },
          "title": "Related Locations",
          "type": "array"
        },
        "rule": {
          "$ref": "#/$defs/RuleMetadata"
        }
      },
      "required": [
        "rule",
        "message",
        "primary_location",
        "paths"
      ],
      "title": "LevelZeroContext",
      "type": "object"
    },
    "PathStep": {
      "additionalProperties": false,
      "description": "One ordered occurrence in a SARIF thread-flow path.",
      "properties": {
        "execution_order": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Order"
        },
        "importance": {
          "anyOf": [
            {
              "enum": [
                "important",
                "essential",
                "unimportant"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Importance"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "kinds": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Kinds",
          "type": "array"
        },
        "location": {
          "$ref": "#/$defs/SourceLocation"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 1000000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "nesting_level": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nesting Level"
        },
        "provenance": {
          "const": "sarif.codeFlows",
          "default": "sarif.codeFlows",
          "title": "Provenance",
          "type": "string"
        },
        "step_kind": {
          "enum": [
            "source",
            "sink",
            "intermediate",
            "unknown"
          ],
          "title": "Step Kind",
          "type": "string"
        }
      },
      "required": [
        "index",
        "location",
        "step_kind"
      ],
      "title": "PathStep",
      "type": "object"
    },
    "RawResultReference": {
      "additionalProperties": false,
      "description": "Stable pointer into the immutable raw SARIF artifact.",
      "properties": {
        "raw_sarif_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sarif Sha256",
          "type": "string"
        },
        "result_index": {
          "minimum": 0,
          "title": "Result Index",
          "type": "integer"
        },
        "run_index": {
          "minimum": 0,
          "title": "Run Index",
          "type": "integer"
        }
      },
      "required": [
        "raw_sarif_sha256",
        "run_index",
        "result_index"
      ],
      "title": "RawResultReference",
      "type": "object"
    },
    "RuleMetadata": {
      "additionalProperties": false,
      "description": "Rule metadata resolved from the result and its tool driver.",
      "properties": {
        "cwe_ids": {
          "default": [],
          "items": {
            "pattern": "^CWE-[1-9][0-9]*$",
            "type": "string"
          },
          "title": "Cwe Ids",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "query_help_uri": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Help Uri"
        },
        "query_pack": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Pack"
        },
        "query_pack_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Pack Version"
        },
        "rule_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "security_severity": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Security Severity"
        },
        "severity": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "tags": {
          "default": [],
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "rule_id"
      ],
      "title": "RuleMetadata",
      "type": "object"
    },
    "SliceContent": {
      "additionalProperties": false,
      "description": "Hashable payload for one alert's Level 0/1 context.",
      "properties": {
        "alert_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Alert Fingerprint",
          "type": "string"
        },
        "candidate_sanitizers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextCandidate"
          },
          "title": "Candidate Sanitizers",
          "type": "array"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ],
          "title": "Completeness",
          "type": "string"
        },
        "context_policy": {
          "enum": [
            "fixed_window",
            "path_function_slice"
          ],
          "title": "Context Policy",
          "type": "string"
        },
        "context_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Context Version",
          "type": "string"
        },
        "guards": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextCandidate"
          },
          "title": "Guards",
          "type": "array"
        },
        "level_zero": {
          "$ref": "#/$defs/LevelZeroContext"
        },
        "maximum_token_budget": {
          "minimum": 1,
          "title": "Maximum Token Budget",
          "type": "integer"
        },
        "omitted": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextOmission"
          },
          "title": "Omitted",
          "type": "array"
        },
        "raw_result_reference": {
          "$ref": "#/$defs/RawResultReference"
        },
        "source_slices": {
          "items": {
            "$ref": "#/$defs/SourceSlice"
          },
          "title": "Source Slices",
          "type": "array"
        },
        "token_estimate": {
          "minimum": 0,
          "title": "Token Estimate",
          "type": "integer"
        }
      },
      "required": [
        "alert_fingerprint",
        "raw_result_reference",
        "context_policy",
        "level_zero",
        "source_slices",
        "token_estimate",
        "maximum_token_budget",
        "completeness"
      ],
      "title": "SliceContent",
      "type": "object"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "description": "A validated source-root-relative physical location.",
      "properties": {
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "column_kind": {
          "enum": [
            "utf16CodeUnits",
            "unicodeCodePoints"
          ],
          "title": "Column Kind",
          "type": "string"
        },
        "end_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Column"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "snippet": {
          "anyOf": [
            {
              "maxLength": 1000000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        },
        "start_column": {
          "default": 1,
          "minimum": 1,
          "title": "Start Column",
          "type": "integer"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "column_kind",
        "start_line"
      ],
      "title": "SourceLocation",
      "type": "object"
    },
    "SourceSlice": {
      "additionalProperties": false,
      "description": "One bounded source excerpt selected for one or more alert locations.",
      "properties": {
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "content": {
          "maxLength": 1000000,
          "title": "Content",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "enclosing_symbol": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enclosing Symbol"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/ContextReference"
          },
          "minItems": 1,
          "title": "References",
          "type": "array"
        },
        "selection": {
          "enum": [
            "fixed_window",
            "enclosing_function"
          ],
          "title": "Selection",
          "type": "string"
        },
        "slice_id": {
          "pattern": "^slice_[0-9a-f]{64}$",
          "title": "Slice Id",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "slice_id",
        "selection",
        "path",
        "start_line",
        "end_line",
        "artifact_sha256",
        "content_sha256",
        "content",
        "references"
      ],
      "title": "SourceSlice",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One reproducible alert context with a digest over its canonical content.",
  "properties": {
    "content": {
      "$ref": "#/$defs/SliceContent"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "slice_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Slice Sha256",
      "type": "string"
    }
  },
  "required": [
    "slice_sha256",
    "content"
  ],
  "title": "SliceArtifact",
  "type": "object"
}
