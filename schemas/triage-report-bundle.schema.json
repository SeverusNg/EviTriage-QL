{
  "$defs": {
    "AlertReport": {
      "additionalProperties": false,
      "description": "One evidence-closed, independently parseable Gate E alert report row.",
      "properties": {
        "alert": {
          "$ref": "#/$defs/NormalizedAlert"
        },
        "context_expansion_history": {
          "items": {
            "$ref": "#/$defs/ReportContextStage"
          },
          "minItems": 1,
          "title": "Context Expansion History",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Evidence",
          "type": "array"
        },
        "human_disagreement": {
          "const": null,
          "default": null,
          "title": "Human Disagreement",
          "type": "null"
        },
        "human_label": {
          "const": null,
          "default": null,
          "title": "Human Label",
          "type": "null"
        },
        "limitations": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "run": {
          "$ref": "#/$defs/ReportRunMetadata"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "slice_artifact": {
          "$ref": "#/$defs/SliceArtifact"
        },
        "triage": {
          "$ref": "#/$defs/TriageResult"
        },
        "unknowns": {
          "default": [],
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        },
        "verification": {
          "$ref": "#/$defs/ReportVerificationSummary"
        }
      },
      "required": [
        "run",
        "alert",
        "slice_artifact",
        "evidence",
        "triage",
        "context_expansion_history",
        "verification",
        "limitations"
      ],
      "title": "AlertReport",
      "type": "object"
    },
    "AnalystOutput": {
      "additionalProperties": false,
      "description": "Structured Analyst result; it proposes claims but no final label.",
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimDraft"
          },
          "maxItems": 64,
          "title": "Claims",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unknowns": {
          "default": [],
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "claims"
      ],
      "title": "AnalystOutput",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "A later-agent assertion whose evidence references must resolve.",
      "properties": {
        "claim_id": {
          "pattern": "^cl_[0-9a-f]{64}$",
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "pattern": "^ev_[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "source_controllable",
            "path_feasible",
            "sanitizer_effective",
            "sink_dangerous",
            "exploit_succeeds"
          ],
          "title": "Kind",
          "type": "string"
        },
        "produced_by": {
          "enum": [
            "analyst",
            "rebuttal",
            "judge"
          ],
          "title": "Produced By",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "statement": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "rebutted",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "kind",
        "statement",
        "status",
        "produced_by"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimDraft": {
      "additionalProperties": false,
      "description": "Agent-authored claim content before code assigns a stable claim ID.",
      "properties": {
        "evidence_ids": {
          "default": [],
          "items": {
            "pattern": "^ev_[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "source_controllable",
            "path_feasible",
            "sanitizer_effective",
            "sink_dangerous",
            "exploit_succeeds"
          ],
          "title": "Kind",
          "type": "string"
        },
        "statement": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "rebutted",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "statement",
        "status"
      ],
      "title": "ClaimDraft",
      "type": "object"
    },
    "ContextCandidate": {
      "additionalProperties": false,
      "description": "A lexical guard or sanitizer candidate, never a semantic fact.",
      "properties": {
        "excerpt": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "extractor": {
          "const": "java-lexical-candidate@1",
          "default": "java-lexical-candidate@1",
          "title": "Extractor",
          "type": "string"
        },
        "kind": {
          "enum": [
            "guard",
            "sanitizer"
          ],
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/SourceLocation"
        }
      },
      "required": [
        "kind",
        "location",
        "excerpt"
      ],
      "title": "ContextCandidate",
      "type": "object"
    },
    "ContextOmission": {
      "additionalProperties": false,
      "description": "One explicit reason requested context could not be included.",
      "properties": {
        "code": {
          "enum": [
            "source_file_missing",
            "source_not_regular",
            "source_too_large",
            "binary_source",
            "unsupported_encoding",
            "coordinate_out_of_bounds",
            "source_digest_mismatch",
            "function_boundary_unresolved",
            "token_budget_exceeded"
          ],
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "code",
        "path",
        "detail"
      ],
      "title": "ContextOmission",
      "type": "object"
    },
    "ContextReference": {
      "additionalProperties": false,
      "description": "Why one normalized source location selected a source slice.",
      "properties": {
        "kind": {
          "enum": [
            "primary",
            "additional",
            "related",
            "source",
            "sink",
            "path_step"
          ],
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/SourceLocation"
        },
        "path_ordinal": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path Ordinal"
        },
        "step_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Index"
        }
      },
      "required": [
        "kind",
        "location"
      ],
      "title": "ContextReference",
      "type": "object"
    },
    "DataFlowPath": {
      "additionalProperties": false,
      "description": "One threadFlow, preserved in original occurrence order.",
      "properties": {
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ],
          "title": "Completeness",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 1000000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "path_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Path Fingerprint",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/PathStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "unresolved_edges": {
          "default": [],
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Unresolved Edges",
          "type": "array"
        }
      },
      "required": [
        "ordinal",
        "steps",
        "path_fingerprint",
        "completeness"
      ],
      "title": "DataFlowPath",
      "type": "object"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "description": "One provenance-bound fact or observation available to later agents.",
      "properties": {
        "alert_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Alert Fingerprint",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^ev_[0-9a-f]{64}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "excerpt": {
          "anyOf": [
            {
              "maxLength": 1000000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "extractor": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Extractor",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "enum": [
            "codeql",
            "repository",
            "build",
            "test",
            "verifier",
            "human"
          ],
          "title": "Origin",
          "type": "string"
        },
        "path_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path Fingerprint"
        },
        "polarity": {
          "enum": [
            "supports_tp",
            "supports_fp",
            "neutral"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "raw_result_reference": {
          "$ref": "#/$defs/RawResultReference"
        },
        "source_anchor": {
          "anyOf": [
            {
              "pattern": "^slice_[0-9a-f]{64}-L[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Anchor"
        },
        "strength": {
          "enum": [
            "low",
            "medium",
            "high",
            "decisive"
          ],
          "title": "Strength",
          "type": "string"
        },
        "summary": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "type": {
          "enum": [
            "source_control",
            "data_flow",
            "sink_semantics",
            "guard",
            "sanitizer",
            "config",
            "permission",
            "test",
            "verification",
            "rebuttal",
            "rule_semantics"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "alert_fingerprint",
        "raw_result_reference",
        "type",
        "polarity",
        "strength",
        "origin",
        "artifact_sha256",
        "extractor",
        "summary"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "FinalDecision": {
      "additionalProperties": false,
      "description": "Judge candidate after the fail-closed deterministic policy is applied.",
      "properties": {
        "auto_dismiss": {
          "const": false,
          "default": false,
          "title": "Auto Dismiss",
          "type": "boolean"
        },
        "calibrated_probabilities": {
          "const": null,
          "default": null,
          "title": "Calibrated Probabilities",
          "type": "null"
        },
        "critical_claim_ids": {
          "default": [],
          "items": {
            "pattern": "^cl_[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Critical Claim Ids",
          "type": "array"
        },
        "critical_evidence_ids": {
          "default": [],
          "items": {
            "pattern": "^ev_[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Critical Evidence Ids",
          "type": "array"
        },
        "fix_guidance": {
          "default": [],
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Fix Guidance",
          "type": "array"
        },
        "label": {
          "enum": [
            "TP",
            "FP",
            "NMC"
          ],
          "title": "Label",
          "type": "string"
        },
        "next_actions": {
          "default": [],
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Next Actions",
          "type": "array"
        },
        "policy_flags": {
          "items": {
            "enum": [
              "auto_dismiss_disabled",
              "conflicting_high_strength_evidence",
              "critical_evidence_missing",
              "fp_decisive_rebuttal_present",
              "fp_missing_decisive_rebuttal",
              "high_strength_fp_blocks_tp",
              "judge_label_accepted",
              "judge_requested_nmc",
              "tp_support_missing",
              "unknown_or_unresolved"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Policy Flags",
          "type": "array"
        },
        "raw_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Raw Confidence",
          "type": "number"
        },
        "reasoning_summary": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Reasoning Summary",
          "type": "string"
        },
        "requested_label": {
          "enum": [
            "TP",
            "FP",
            "NMC"
          ],
          "title": "Requested Label",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TriageTarget"
        },
        "unknowns": {
          "default": [],
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "target",
        "label",
        "requested_label",
        "raw_confidence",
        "reasoning_summary",
        "policy_flags"
      ],
      "title": "FinalDecision",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "JudgeOutput": {
      "additionalProperties": false,
      "description": "Untrusted Judge candidate evaluated by deterministic code policy.",
      "properties": {
        "critical_claim_ids": {
          "default": [],
          "items": {
            "pattern": "^cl_[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Critical Claim Ids",
          "type": "array"
        },
        "critical_evidence_ids": {
          "default": [],
          "items": {
            "pattern": "^ev_[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Critical Evidence Ids",
          "type": "array"
        },
        "fix_guidance": {
          "default": [],
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Fix Guidance",
          "type": "array"
        },
        "label": {
          "enum": [
            "TP",
            "FP",
            "NMC"
          ],
          "title": "Label",
          "type": "string"
        },
        "next_actions": {
          "default": [],
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Next Actions",
          "type": "array"
        },
        "raw_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Raw Confidence",
          "type": "number"
        },
        "reasoning_summary": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Reasoning Summary",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unknowns": {
          "default": [],
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "label",
        "raw_confidence",
        "reasoning_summary"
      ],
      "title": "JudgeOutput",
      "type": "object"
    },
    "LevelZeroContext": {
      "additionalProperties": false,
      "description": "Normalized alert facts included without reparsing SARIF.",
      "properties": {
        "additional_locations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceLocation"
          },
          "title": "Additional Locations",
          "type": "array"
        },
        "message": {
          "maxLength": 1000000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/DataFlowPath"
          },
          "title": "Paths",
          "type": "array"
        },
        "primary_location": {
          "$ref": "#/$defs/SourceLocation"
        },
        "related_locations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceLocation"
          },
          "title": "Related Locations",
          "type": "array"
        },
        "rule": {
          "$ref": "#/$defs/RuleMetadata"
        }
      },
      "required": [
        "rule",
        "message",
        "primary_location",
        "paths"
      ],
      "title": "LevelZeroContext",
      "type": "object"
    },
    "ModelInvocationRecord": {
      "additionalProperties": false,
      "description": "Non-secret provenance for one accepted or rejected structured call.",
      "properties": {
        "agent_role": {
          "enum": [
            "analyst",
            "rebuttal",
            "judge"
          ],
          "title": "Agent Role",
          "type": "string"
        },
        "attempt": {
          "maximum": 1,
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "error_code": {
          "anyOf": [
            {
              "const": "MODEL_RESPONSE_INVALID",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "model_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "profile_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "title": "Profile Id",
          "type": "string"
        },
        "prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "response_schema": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Response Schema",
          "type": "string"
        },
        "response_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Sha256"
        },
        "status": {
          "enum": [
            "accepted",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "agent_role",
        "attempt",
        "request_sha256",
        "prompt_sha256",
        "response_schema",
        "profile_id",
        "model_id",
        "status"
      ],
      "title": "ModelInvocationRecord",
      "type": "object"
    },
    "NormalizedAlert": {
      "additionalProperties": false,
      "description": "Provider-neutral normalized representation of one SARIF result.",
      "properties": {
        "additional_locations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceLocation"
          },
          "title": "Additional Locations",
          "type": "array"
        },
        "alert_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Alert Fingerprint",
          "type": "string"
        },
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "fingerprints": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Fingerprints",
          "type": "object"
        },
        "has_code_flows": {
          "title": "Has Code Flows",
          "type": "boolean"
